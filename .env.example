# Public site URL. Without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://openportsgames.example

# Optional voluntary donation link (shown on /support).
# Empty or unset hides the support section from the navigation.
PAYPAL_DONATION_URL=

# Base path for deployments that serve the site from a subfolder
# (for example GitHub Pages: https://user.github.io/openportsgames).
NEXT_PUBLIC_BASE_PATH=