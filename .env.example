# Public site URL, without a trailing slash. Used for canonical URLs,
# Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://openportsgames.example

# Base path when the site is served from a subfolder, e.g. GitHub Pages
# at https://user.github.io/openportsgames:
# NEXT_PUBLIC_BASE_PATH=/openportsgames
NEXT_PUBLIC_BASE_PATH=

# Optional voluntary donation link shown on /support.
# Empty or unset: the page shows a neutral "support coming soon" note,
# no dead button is rendered.
# Format: one hosted button URL, e.g. https://www.paypal.com/donate/?hosted_button_id=5WK2PSB9MV4GW
NEXT_PUBLIC_SUPPORT_PAYPAL_URL=
