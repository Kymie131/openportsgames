# Public site URL, without a trailing slash. Used for canonical URLs,
# Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://openportsgames.com

# Base path when the site is served from a subfolder, e.g.
# https://user.github.io/openportsgames. Leave unset for a domain root
# deployment such as Cloudflare Pages.
# NEXT_PUBLIC_BASE_PATH=/openportsgames
NEXT_PUBLIC_BASE_PATH=

# Optional voluntary donation link shown on /support.
# Empty or unset: the page shows a neutral "support coming soon" note,
# no dead button is rendered.
# Format: one hosted button URL, e.g. https://www.paypal.com/donate/?hosted_button_id=5WK2PSB9MV4GW
NEXT_PUBLIC_SUPPORT_PAYPAL_URL=

# Backend origin (Cloudflare Worker), without a trailing slash. Auth, ratings
# and comments are fetched from here. The origin must also be allowed in
# public/_headers under connect-src.
NEXT_PUBLIC_API_URL=https://api.openportsgames.com

# Cloudflare Turnstile site key (public) used by the comment box.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Contact address shown on /privacy and /terms. Placeholder until set.
NEXT_PUBLIC_CONTACT_EMAIL=privacy@openportsgames.example
